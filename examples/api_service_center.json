{
  "project_name": "api-service-center-demo",
  "simulation": {
    "name": "two-stage-service-center",
    "until": 120,
    "warmup": 20,
    "first_arrival_at_zero": true,
    "max_arrivals": 100,
    "arrival_interarrival": {
      "kind": "exponential",
      "mean": 5.0
    },
    "stations": [
      {
        "name": "registration",
        "capacity": 1,
        "service_time": {
          "kind": "exponential",
          "mean": 3.0
        }
      },
      {
        "name": "specialist",
        "capacity": 2,
        "service_time": {
          "kind": "triangular",
          "low": 4.0,
          "mode": 8.0,
          "high": 15.0
        }
      }
    ],
    "cycle_time_target": 30
  },
  "experiment": {
    "replications": 5,
    "base_seed": 20260825,
    "common_random_numbers": true,
    "confidence_level": 0.95,
    "parameter_grid": {},
    "output_dir": "ignored-by-control-api"
  },
  "openai": {
    "model": "gpt-5.6",
    "max_output_tokens": 1500,
    "timeout_seconds": 60,
    "max_retries": 2,
    "store": false
  }
}
